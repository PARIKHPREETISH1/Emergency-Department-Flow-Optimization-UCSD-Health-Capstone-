    def log_normal_params(mean, std):
        """Calculate the mu and sigma for the log-normal distribution."""
        sigma = np.sqrt(np.log(1 + (std**2 / mean**2)))
        mu = np.log(mean**2 / np.sqrt(std**2 + mean**2))
        return mu, sigma

