    def convert_minutes_to_timestamp(sim_time):
        """Convert simulation time in minutes to a timestamp."""
        # Assuming simulation starts at day 0, hour 0
        days, remainder = divmod(sim_time, 24 * 60)  # Divide by number of minutes in a day
        hours, minutes = divmod(remainder, 60)  # Get hours and minutes
        return f"Day {int(days)}, {int(hours):02d}:{int(minutes):02d}"
    def fix_discharge_time():
        """Generate a discharge time from a bell curve between 10 AM and 10 PM."""
        mean = 16 * 60  # 4 PM (16:00) in minutes
        std_dev = 2 * 60  # Standard deviation of 2 hours (120 minutes)
        
        while True:
            # Generate a random discharge time using a normal distribution
            discharge_time = int(np.random.normal(mean, std_dev))
            
            # Convert to hours and ensure it is between 10 AM and 10 PM
            discharge_hour = (discharge_time // 60) % 24
            if 10 <= discharge_hour <= 22:  # Only accept times between 10 AM and 10 PM
                return discharge_time

   
   # Function to adjust discharge time and shift based on forward/backward
    def shift_discharge_time_and_adjust_treatment(patient, admission_time, hospital_time):
        # Step 1: Calculate the original discharge time (before shifting)
        current_discharge_time = admission_time + hospital_time
        current_discharge_hour = (current_discharge_time // 60) % 24
        current_discharge_minutes = current_discharge_time % 60  # Extract the excess minutes

        
        # Step 2: Generate a new discharge hour from the bell curve
        new_discharge_time = fix_discharge_time()  # Generate a discharge time between 10 AM and 10 PM
        new_discharge_hour = (new_discharge_time // 60) % 24
        
        # Step 3: Apply the logic based on current discharge hour
        if 0 <= current_discharge_hour < 4:
            # Shift back to the previous day at the new discharge time
        
            new_discharge_time = ((current_discharge_time // (24 * 60)) - 1) * 24 * 60 + (new_discharge_hour * 60) + current_discharge_minutes
        else:
            # Stay on the same day at the new discharge time
        
            new_discharge_time = (current_discharge_time // (24 * 60)) * 24 * 60 + (new_discharge_hour * 60) + current_discharge_minutes
        
        # Step 4: Ensure the new discharge time is after the admission time
        if new_discharge_time <= admission_time:
            new_discharge_time = admission_time + hospital_time  # Fallback to original time to avoid negative stay
           
        
        # Step 5: Adjust the hospital treatment time based on the new discharge time
        new_hospital_time = new_discharge_time - admission_time

        # Step 6: Return the new discharge time, new hospital treatment time, and the type of shift
        return new_discharge_time, new_hospital_time, new_discharge_hour
    
