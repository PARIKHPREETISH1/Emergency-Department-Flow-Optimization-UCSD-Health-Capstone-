            edip_matrix[week-1, day] = volume  # -1 to adjust for 0-based index

    # Create a heatmap
    plt.figure(figsize=(12, 8))
    sns.heatmap(edip_matrix, cmap="YlGnBu", annot=True, fmt=".1f", cbar=True,
                xticklabels=[ 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday',],
                yticklabels=[f'Week {i+1}' for i in range(max_week)])
    plt.xlabel('Day of the Week')
    plt.ylabel('Week')
    plt.title('Heatmap of EDIP Volumes')
    plt.show()



